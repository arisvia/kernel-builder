# ==============================================================
# Device Profile: Xiaomi Mi Mix 2S (polaris) - SDM845 Linux 4.19
# ==============================================================

DEVICE_NAME="polaris"
DEVICE_MODEL="Xiaomi Mi Mix 2S"

# Kernel Source & Branch (maintained in this repository's sdm845 branch, Linux 4.19.325)
KERNEL_REPO="https://github.com/arisvia/kernel-builder"
KERNEL_BRANCH="sdm845"

# Architecture and Defconfig (SDM845 4.19.325 unified defconfig chain)
ARCH="arm64"
KERNEL_DEFCONFIG="vendor/xiaomi/polaris_defconfig"

# Target Kernel Image
KERNEL_IMAGE_NAME="Image.gz-dtb"

# Kernel Version Classification
KERNEL_VERSION_TYPE="4.19"

# Base stock boot.img used to synthesize standalone fastboot boot.img (Header v1, stock ramdisk)
BASE_BOOT_URL="https://github.com/arisvia/kernel-builder/releases/download/base-assets/boot.img"

# Clang Toolchain (Modern AOSP Clang 20.0.0 r547379 from main + pure LLVM=1)
CLANG_BRANCH="main"
CLANG_DIR_NAME="clang-r547379"

# BakaSU Configuration
KSU_HOOK_METHOD="manual"

# Critical Kernel Configurations required for this device/platform
CHECK_CONFIGS="CONFIG_EROFS_FS CONFIG_PERF_EVENTS CONFIG_UPROBES CONFIG_UPROBE_EVENTS CONFIG_BPF_EVENTS CONFIG_NET_ACT_BPF"
